generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int     @id @default(autoincrement())
  firstname String
  lastname  String
  email     String  @unique
  password  String
  role      String  @default("USER")
  isActive  Boolean @default(true)

  @@map("users")
}

model poster {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String
  description String
  image       String
  width       Int
  height      Int
  price       Float
  stock       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  genres genrePosterRel[]
}

model genre {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posters genrePosterRel[]
}

model genrePosterRel {
  genreId  Int
  posterId Int
  genre    genre  @relation(fields: [genreId], references: [id])
  poster   poster @relation(fields: [posterId], references: [id])

  @@id([genreId, posterId])
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  firstname String
  lastname  String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  cartlines   cartlines[]
  userRatings userRatings[]

  @@map("users")
}

model poster {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String
  description String
  image       String
  width       Int
  height      Int
  price       Decimal
  stock       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  genres      genrePosterRel[]
  cartlines   cartlines[]
  userRatings userRatings[]

  @@map("posters")
}

model genre {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posters genrePosterRel[]

  @@map("genres")
}

model genrePosterRel {
  genreId  Int
  posterId Int
  genre    genre  @relation(fields: [genreId], references: [id])
  poster   poster @relation(fields: [posterId], references: [id])

  @@id([genreId, posterId])
}

model cartlines {
  id        Int      @id @default(autoincrement())
  userId    Int
  posterId  Int
  quantity  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  poster poster @relation(fields: [posterId], references: [id])
}

model userRatings {
  id        Int      @id @default(autoincrement())
  userId    Int
  posterId  Int
  numStars  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  poster poster @relation(fields: [posterId], references: [id])
}

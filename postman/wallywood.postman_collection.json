      "item": [
        {
          "name": "Login som admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"info@webudvikler.dk\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Svaret indeholder et accessToken\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"accessToken\");",
                  "});",
                  "",
                  "pm.test(\"Brugeren har rollen ADMIN\", function () {",
                  "    pm.expect(pm.response.json().user.role).to.eql(\"ADMIN\");",
                  "});",
                  "",
                  "pm.environment.set(\"accessToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "response": []
        },
